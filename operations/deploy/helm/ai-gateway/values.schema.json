        "userId": {
          "const": 3000
        },
        "groupId": {
          "const": 2000
        }
      },
      "required": [
        "projectName",
        "userId",
        "groupId"
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "ai-gateway"
        },
        "imageTag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "imagePullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "replicaCount": {
          "const": 1
        },
        "profile": {
          "const": "prod"
        },
        "containerPort": {
          "const": 8080
        }
