    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "const": "tc"
        },
        "imagePullSecret": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "registry",
        "namespace",
        "imagePullSecret"
      ]
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectName": {
          "type": "string",
          "minLength": 1
