FROM harbor.nori.local/library/eclipse-temurin:21-jre-jammy

ENV JAVA_OPTS="-XX:+UseG1GC -XX:+UseContainerSupport" \
    TZ=Asia/Seoul \
    USER_ID=3000 \
    GROUP_ID=2000 \
    AI_GATEWAY_TOKENIZER_FILE=/app/tokenizer/qwen3-4b-thinking-2507.tokenizer.json

RUN groupadd -g ${GROUP_ID} mesgroup && \
    useradd -l -u ${USER_ID} -g mesgroup -m -s /bin/bash mesuser
WORKDIR /app
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
COPY --chown=mesuser:mesgroup app.jar /app/app.jar
# 1MiB를 넘는 tokenizer는 설정 볼륨 대신 이미지에 포함합니다.
COPY --chown=mesuser:mesgroup modules/adapter/ai-gateway-inference-adapter/src/main/resources/tokenizer/qwen3-4b-thinking-2507.tokenizer.json /app/tokenizer/qwen3-4b-thinking-2507.tokenizer.json
RUN mkdir -p /app/config && chown -R mesuser:mesgroup /app
USER mesuser
RUN java -Dai.djl.offline=true \
    -Dloader.main=com.nori.ai.gateway.app.safety.NativeTokenizerOfflineCheck \
    -cp /app/app.jar org.springframework.boot.loader.launch.PropertiesLauncher
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -Dai.djl.offline=true -jar /app/app.jar"]
